---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const items = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{
  items.length > 0 && (
    <nav class="toc" aria-label="On this page">
      <p class="toc__title">On this page</p>
      <ol class="toc__list">
        {items.map((h) => (
          <li class:list={["toc__item", h.depth === 3 && "toc__item--sub"]}>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .toc {
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    border-radius: var(--radius);
    padding: 1rem 1.1rem;
    margin: 0 0 1.5rem;
  }

  .toc__title {
    margin: 0 0 0.5rem;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .toc__list {
    margin: 0;
    padding-left: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .toc__item a {
    color: var(--text);
    text-decoration: none;
    font-size: 0.95rem;
  }

  .toc__item a:hover {
    color: var(--accent-bright);
  }

  .toc__item--sub {
    list-style-type: circle;
  }
</style>
