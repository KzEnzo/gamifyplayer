---
import { games, type GameId } from "../data/games";

interface Props {
  game: GameId;
  gameVersion: string;
  lastVerified: Date;
  platforms: string[];
  tags?: string[];
  difficulty?: "Beginner" | "Intermediate" | "Advanced";
}

const { game, gameVersion, lastVerified, platforms, tags = [], difficulty } = Astro.props;
const g = games[game];
const verified = lastVerified.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<div class="meta-bar" aria-label="Guide verification">
  <span class="pill" style={`border-color: ${g.accent}55; color: ${g.accent}`}>{g.name}</span>
  <span class="pill">Build / patch: {gameVersion}</span>
  <span class="pill pill--warn">Last verified: {verified}</span>
  <span class="pill">Platforms: {platforms.join(", ")}</span>
  {difficulty && <span class="pill pill--accent">Difficulty: {difficulty}</span>}
  {tags.map((t) => (
    <span class="pill" key={t}>{t}</span>
  ))}
</div>
