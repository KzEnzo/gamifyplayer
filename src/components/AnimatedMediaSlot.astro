---
import { withBase } from "../utils/withBase";

interface Props {
  hasAnimatedMedia: boolean;
  src?: string;
  alt?: string;
  /** When true, slot is visually emphasized (detail page hero). */
  preferTop?: boolean;
}

const { hasAnimatedMedia, src, alt, preferTop } = Astro.props;
const resolvedSrc = src && src.startsWith("/") ? withBase(src) : src;
const filled = Boolean(hasAnimatedMedia && resolvedSrc);
---

<div class:list={["slot", filled && "slot--filled", preferTop && "slot--hero"]} data-animated-slot>
  <div class="slot__label">Motion reference (GIF / short clip)</div>
  {
    filled ? (
      <figure style="margin:0">
        <img src={resolvedSrc} alt={alt ?? "Animated gameplay reference"} loading="lazy" width={960} height={540} />
        {alt && <figcaption class="muted" style="margin-top:0.5rem">{alt}</figcaption>}
      </figure>
    ) : (
      <p class="slot-placeholder">
        {hasAnimatedMedia
          ? "Animated reference will appear here after you add `animatedMediaSrc` in frontmatter (e.g. exported GIF under /public/media/)."
          : "No motion asset for this guide yet. Toggle `hasAnimatedMedia` when a GIF is ready — it will be prioritized on the home feed."}
      </p>
    )}
</div>

<style>
  .slot--hero {
    padding: 1.25rem;
    border-width: 2px;
  }
</style>
