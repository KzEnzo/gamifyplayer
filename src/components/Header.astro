---
import { withBase } from "../utils/withBase";

/** Normalize so `/foo/` and `/foo` match; root becomes `/`. */
function normPath(p: string) {
  const t = p.replace(/\/+$/, "");
  return t === "" ? "/" : t;
}

const pathname = normPath(Astro.url.pathname);
const homePath = normPath(withBase("/"));

function isCurrent(href: string) {
  const item = normPath(href);
  /* Home must match exactly — otherwise /base/foo matches home /base */
  if (item === homePath) return pathname === homePath;
  return pathname === item || pathname.startsWith(`${item}/`);
}

const links = [
  { href: withBase("/"), label: "Home" },
  { href: withBase("/guides/"), label: "Guides" },
  { href: withBase("/briefings/"), label: "Briefings" },
  { href: withBase("/tools/"), label: "Tools" },
  { href: withBase("/search/"), label: "Search" },
  { href: withBase("/about/"), label: "About" },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="logo" href={withBase("/")}>Gamify<span>Player</span></a>
    <nav class="nav" aria-label="Primary">
      {
        links.map(({ href, label }) => (
          <a href={href} aria-current={isCurrent(href) ? "page" : undefined}>
            {label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
