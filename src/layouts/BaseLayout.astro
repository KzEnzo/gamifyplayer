---
import { withBase } from "../utils/withBase";

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
}

const { title, description = "Narrow, deep, version-verified game guides and low-risk tools for global players.", canonicalPath } = Astro.props;
const canonical =
  Astro.site && canonicalPath ? new URL(withBase(canonicalPath), Astro.site.toString()).href : undefined;
const cfToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} | GamifyPlayer</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href={withBase("/favicon.png")} type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href={withBase("/favicon.png")} />
    <!-- Pagefind: run `npm run build:search` after `npm run build`, then deploy `dist/` with `/pagefind` assets. Uncomment UI on /search when ready. -->
    <slot name="head" />
    {
      cfToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: cfToken })}
        />
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
