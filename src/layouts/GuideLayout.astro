---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import GuideMeta from "../components/GuideMeta.astro";
import AnimatedMediaSlot from "../components/AnimatedMediaSlot.astro";
import Toc from "../components/Toc.astro";
import "../styles/global.css";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  game: import("../data/games").GameId;
  gameVersion: string;
  lastVerified: Date;
  platforms: string[];
  hasAnimatedMedia: boolean;
  animatedMediaSrc?: string;
  animatedMediaAlt?: string;
  canonicalPath: string;
  headings?: Heading[];
}

const {
  title,
  description,
  game,
  gameVersion,
  lastVerified,
  platforms,
  hasAnimatedMedia,
  animatedMediaSrc,
  animatedMediaAlt,
  canonicalPath,
  headings = [],
} = Astro.props;
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath}>
  <Header />
  <main class="container page-main">
    <article class="prose">
      <p class="pill pill--accent">Single-problem guide</p>
      <h1>{title}</h1>
      <GuideMeta
        game={game}
        gameVersion={gameVersion}
        lastVerified={lastVerified}
        platforms={platforms}
      />
      <AnimatedMediaSlot
        hasAnimatedMedia={hasAnimatedMedia}
        src={animatedMediaSrc}
        alt={animatedMediaAlt}
        preferTop={true}
      />
      <Toc headings={headings} />
      <slot />
    </article>
  </main>
  <Footer />
</BaseLayout>
