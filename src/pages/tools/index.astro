---
import PageLayout from "../../layouts/PageLayout.astro";
import { withBase } from "../../utils/withBase";
---

<PageLayout title="Tools" description="Low-risk helpers: checklists, calendars, and future map overlays." canonicalPath="/tools/">
  <h1>Tools</h1>
  <p class="muted" style="max-width: 72ch">
    Everything here runs as static HTML (with optional vanilla interactions). No executables, no memory hooks, no rebroadcasting of protected assets.
  </p>

  <div class="card-grid" style="margin-top: 2rem">
    <a class="card" href={withBase("/tools/once-human-materials/")} style="text-decoration: none; color: inherit">
      <h2>Once Human · Materials</h2>
      <p>Tick-friendly checklist for condenser loops and vendor refreshes.</p>
      <span class="pill pill--accent">Live</span>
    </a>
    <a class="card" href={withBase("/tools/event-calendar/")} style="text-decoration: none; color: inherit">
      <h2>UTC event shell</h2>
      <p>Weekly reset template you can duplicate per season.</p>
      <span class="pill pill--accent">Live</span>
    </a>
    <a class="card" href={withBase("/tools/map-hub/")} style="text-decoration: none; color: inherit">
      <h2>Map hub</h2>
      <p>Placeholder for annotated routes once sourcing is cleared.</p>
      <span class="pill">Reserved</span>
    </a>
  </div>
</PageLayout>
