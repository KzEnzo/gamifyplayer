---
import PageLayout from "../../layouts/PageLayout.astro";
---

<PageLayout title="Map hub" description="Reserved entry for future annotated maps and route overlays." canonicalPath="/tools/map-hub/">
  <p class="pill">Reserved</p>
  <h1>Map hub</h1>
  <p class="muted" style="max-width: 72ch">
    We will publish interactive or image-based maps only when we can source tiles ethically (developer APIs, licensed assets, or player-captured overlays on permissive terms).
  </p>
  <div class="slot" style="margin-top: 1.5rem">
    <div class="slot__label">Future embed</div>
    <p class="slot-placeholder">Planned: SVG route overlays + deep links back into single-problem guides.</p>
  </div>
</PageLayout>
