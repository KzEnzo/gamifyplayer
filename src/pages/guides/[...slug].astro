---
import { getCollection, render } from "astro:content";
import GuideLayout from "../../layouts/GuideLayout.astro";

export async function getStaticPaths() {
  const guides = await getCollection("guides", ({ data }) => data.publish !== false);
  return guides.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
---

<GuideLayout
  title={d.title}
  description={d.description}
  game={d.game}
  gameVersion={d.gameVersion}
  lastVerified={d.lastVerified}
  platforms={d.platforms}
  hasAnimatedMedia={d.hasAnimatedMedia}
  animatedMediaSrc={d.animatedMediaSrc}
  animatedMediaAlt={d.animatedMediaAlt}
  canonicalPath={`/guides/${entry.slug}/`}
  headings={headings}
  tags={d.tags}
  difficulty={d.difficulty}
>
  <Content />
</GuideLayout>
