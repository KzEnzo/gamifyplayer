---
import PageLayout from "../../layouts/PageLayout.astro";
import { getCollection } from "astro:content";
import { games, type GameId } from "../../data/games";
import { withBase } from "../../utils/withBase";

const guides = (await getCollection("guides", ({ data }) => data.publish !== false)).sort((a, b) => {
  const af = a.data.hasAnimatedMedia && a.data.animatedMediaSrc ? 2 : a.data.hasAnimatedMedia ? 1 : 0;
  const bf = b.data.hasAnimatedMedia && b.data.animatedMediaSrc ? 2 : b.data.hasAnimatedMedia ? 1 : 0;
  if (bf !== af) return bf - af;
  return b.data.lastVerified.getTime() - a.data.lastVerified.getTime();
});

function gameName(id: GameId) {
  return games[id].name;
}
---

<PageLayout title="Guides" description="Single-problem guides with explicit verification metadata." canonicalPath="/guides/">
  <h1>Guides</h1>
  <p class="muted" style="max-width: 62ch">
    Sorted with motion-backed guides first, then by last verified date. Every guide exposes build/patch, platforms, and anchors for quick scanning.
  </p>
  <ul class="list-plain" style="margin-top: 2rem">
    {
      guides.map((g) => (
        <li>
          <a href={withBase(`/guides/${g.slug}/`)}>{g.data.title}</a>
          <div class="muted" style="margin-top: 0.25rem">
            {gameName(g.data.game)} · Verified {g.data.lastVerified.toLocaleDateString("en-US")} ·{" "}
            {g.data.hasAnimatedMedia ? (
              g.data.animatedMediaSrc ? (
                <span class="pill pill--accent" style="margin-left: 0.35rem">
                  Motion asset
                </span>
              ) : (
                <span class="pill pill--accent" style="margin-left: 0.35rem">
                  Motion reserved
                </span>
              )
            ) : (
              <span class="pill" style="margin-left: 0.35rem">
                Text-first
              </span>
            )}
          </div>
        </li>
      ))
    }
  </ul>
</PageLayout>
