---
import PageLayout from "../../layouts/PageLayout.astro";
import { gameOrder, games, type GameId } from "../../data/games";
import { getCollection } from "astro:content";
import { withBase } from "../../utils/withBase";

export function getStaticPaths() {
  return gameOrder.map((game) => ({ params: { game } }));
}

const { game } = Astro.params as { game: GameId };
const meta = games[game];

const guides = (await getCollection("guides", ({ data }) => data.publish !== false))
  .filter((g) => g.data.game === game)
  .sort((a, b) => b.data.lastVerified.getTime() - a.data.lastVerified.getTime());

const briefings = (await getCollection("briefings", ({ data }) => data.publish !== false))
  .filter((n) => n.data.game === game)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const toolLinks: Record<GameId, { href: string; label: string }[]> = {
  "once-human": [
    { href: "/tools/once-human-materials/", label: "Material checklist" },
    { href: "/tools/event-calendar/", label: "Event calendar (UTC)" },
    { href: "/tools/map-hub/", label: "Map hub (coming soon)" },
  ],
  "gta-6": [
    { href: "/tools/event-calendar/", label: "Event calendar (UTC)" },
    { href: "/tools/map-hub/", label: "Map hub (coming soon)" },
  ],
  "red-desert": [
    { href: "/tools/map-hub/", label: "Map hub (coming soon)" },
    { href: "/tools/event-calendar/", label: "Event calendar (UTC)" },
  ],
};
---

<PageLayout title={meta.name} description={meta.tagline} canonicalPath={`/games/${game}/`}>
  <p class="pill" style={`border-color:${meta.accent}55;color:${meta.accent}`}>Game hub</p>
  <h1 style={`margin-top:0.5rem`}>{meta.name}</h1>
  <p class="muted" style="max-width: 70ch">
    {meta.tagline}
  </p>
  <div class="notice" style="margin-top: 1.25rem">
    <strong style="color: var(--text)">Version stance:</strong>
    {meta.versionNote}
    <div class="muted" style="margin-top: 0.35rem">Hub copy last reviewed: {meta.lastPageReview}</div>
  </div>

  <div class="section-title">
    <h2>Guides</h2>
    <a href={withBase("/guides/")}>View all guides</a>
  </div>
  {
    guides.length === 0 ? (
      <p class="muted">Guides are being staged for this title — check back after the next verified play session.</p>
    ) : (
      <ul class="list-plain">
        {guides.map((g) => (
          <li>
            <a href={withBase(`/guides/${g.slug}/`)}>{g.data.title}</a>
            <div class="muted" style="margin-top: 0.25rem">
              Patch {g.data.gameVersion} · Verified {g.data.lastVerified.toLocaleDateString("en-US")}
            </div>
          </li>
        ))}
      </ul>
    )
  }

  <div class="section-title">
    <h2>Briefings</h2>
    <a href={withBase("/briefings/")}>All briefings</a>
  </div>
  {
    briefings.length === 0 ? (
      <p class="muted">No briefings for this hub yet — we publish when there is a player-impact angle.</p>
    ) : (
      <ul class="list-plain">
        {briefings.map((n) => (
          <li>
            <a href={withBase(`/briefings/${n.slug}/`)}>{n.data.title}</a>
            <div class="muted" style="margin-top: 0.25rem">
              {n.data.date.toLocaleDateString("en-US")} · {n.data.tags.slice(0, 3).join(", ")}
            </div>
          </li>
        ))}
      </ul>
    )
  }

  <div class="section-title">
    <h2>Tools</h2>
    <a href={withBase("/tools/")}>Tool index</a>
  </div>
  <div class="card-grid">
    {
      toolLinks[game].map((t) => (
        <a class="card" href={withBase(t.href)} style="text-decoration:none;color:inherit">
          <h3>{t.label}</h3>
          <p>Low-risk helper — no automation, no client hooks.</p>
        </a>
      ))
    }
  </div>
</PageLayout>
