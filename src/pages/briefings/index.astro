---
import PageLayout from "../../layouts/PageLayout.astro";
import { getCollection } from "astro:content";
import { games, type GameId } from "../../data/games";
import { withBase } from "../../utils/withBase";

const items = (await getCollection("briefings", ({ data }) => data.publish !== false)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

function gameName(id?: GameId) {
  if (!id) return "General";
  return games[id].name;
}
---

<PageLayout title="Briefings" description="Lightweight digests of official updates, streams, and forward-looking prep." canonicalPath="/briefings/">
  <h1>Briefings</h1>
  <p class="muted" style="max-width: 62ch">
    We are not a headline factory — each note explains what changed for players and how it connects to our version-checked guides.
  </p>
  <ul class="list-plain" style="margin-top: 2rem">
    {
      items.map((n) => (
        <li>
          <a href={withBase(`/briefings/${n.slug}/`)}>{n.data.title}</a>
          <div class="muted" style="margin-top: 0.25rem">
            {gameName(n.data.game)} · {n.data.date.toLocaleDateString("en-US")} · {n.data.tags.slice(0, 3).join(", ")}
          </div>
        </li>
      ))
    }
  </ul>
</PageLayout>
