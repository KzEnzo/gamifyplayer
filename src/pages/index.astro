---
import PageLayout from "../layouts/PageLayout.astro";
import { getCollection } from "astro:content";
import { gameOrder, games, type GameId } from "../data/games";
import AnimatedMediaSlot from "../components/AnimatedMediaSlot.astro";
import { withBase } from "../utils/withBase";

const guides = await getCollection("guides");
const news = await getCollection("news");

function homeGuideSort(a: (typeof guides)[number], b: (typeof guides)[number]) {
  const af = a.data.hasAnimatedMedia && a.data.animatedMediaSrc ? 2 : a.data.hasAnimatedMedia ? 1 : 0;
  const bf = b.data.hasAnimatedMedia && b.data.animatedMediaSrc ? 2 : b.data.hasAnimatedMedia ? 1 : 0;
  if (bf !== af) return bf - af;
  return b.data.lastVerified.getTime() - a.data.lastVerified.getTime();
}

const sortedGuides = [...guides].sort(homeGuideSort);
const motionSpotlight = sortedGuides.filter((g) => g.data.hasAnimatedMedia).slice(0, 3);
const latestGuides = sortedGuides.slice(0, 6);
const latestNews = [...news].sort((a, b) => b.data.published.getTime() - a.data.published.getTime()).slice(0, 4);

function gameName(id: GameId) {
  return games[id].name;
}
---

<PageLayout
  title="Home"
  description="Narrow, deep, version-verified guides with motion references and low-risk tools for global players."
  canonicalPath="/"
>
  <section class="hero">
    <h1>Guides that ship with a patch date, not a promise.</h1>
    <p class="lead">
      GamifyPlayer is a static-first player companion for <strong>Red Desert</strong>, <strong>GTA 6</strong>, and <strong>Once Human</strong> — one problem per page,
      explicit verification metadata, and lightweight tools you can trust on ToS-safe ground.
    </p>
  </section>

  <section class="reader-hint" aria-labelledby="reader-hint-title">
    <h2 id="reader-hint-title" class="reader-hint__title">How to read this site (about one minute)</h2>
    <ol class="reader-hint__list">
      <li><strong>Pick a game</strong> — the three cards below open a hub: guides, briefings, and tools for that title.</li>
      <li><strong>Open a guide</strong> — each guide solves <em>one</em> problem. The gray pills are metadata: game patch, last verified date, and platforms (PC / console).</li>
      <li><strong>Motion box</strong> — space for a short gameplay GIF. If you see a dashed frame, the clip is not uploaded yet.</li>
    </ol>
    <p class="reader-hint__note">
      The site is in English for a global audience. The theme is dark for comfortable night reading; red is only used for small highlights so pages stay easy to scan.
    </p>
  </section>

  <div class="card-grid" style="margin-top: 2rem">
    {
      gameOrder.map((id) => (
        <a class="card" href={withBase(`/games/${id}/`)} style={`text-decoration:none;color:inherit;border-color:${games[id].accent}44`}>
          <h2>{games[id].name}</h2>
          <p>{games[id].tagline}</p>
          <span class="pill" style={`border-color:${games[id].accent}55;color:${games[id].accent}`}>
            Open hub
          </span>
        </a>
      ))
    }
  </div>

  <div class="section-title">
    <h2>Motion spotlight</h2>
    <a href={withBase("/guides/")}>Guides library</a>
  </div>
  <p class="muted" style="margin-top: -0.5rem; max-width: 72ch">
    Guides with <code>hasAnimatedMedia</code> surface first. When a GIF lands in <code>animatedMediaSrc</code>, the card shows a live preview — until then you will see the reserved slot copy.
  </p>
  <div class="card-grid">
    {
      motionSpotlight.map((g) => (
        <article class="card">
          <h3>
            <a href={withBase(`/guides/${g.slug}/`)} style="color: inherit; text-decoration: none">
              {g.data.title}
            </a>
          </h3>
          <p>{g.data.description}</p>
          <div class="muted" style="font-size: 0.9rem">
            {gameName(g.data.game)} · {g.data.lastVerified.toLocaleDateString("en-US")}
          </div>
          <AnimatedMediaSlot
            hasAnimatedMedia={g.data.hasAnimatedMedia}
            src={g.data.animatedMediaSrc}
            alt={g.data.animatedMediaAlt}
            preferTop={false}
          />
        </article>
      ))
    }
  </div>

  <div class="section-title">
    <h2>Latest verified guides</h2>
    <span class="muted">Sorted: motion-backed first</span>
  </div>
  <ul class="list-plain">
    {
      latestGuides.map((g) => (
        <li>
          <a href={withBase(`/guides/${g.slug}/`)}>{g.data.title}</a>
          <div class="muted" style="margin-top: 0.25rem">
            {gameName(g.data.game)} · Patch {g.data.gameVersion} · Verified {g.data.lastVerified.toLocaleDateString("en-US")}
            {g.data.hasAnimatedMedia && (
              <span class="pill pill--accent" style="margin-left: 0.35rem">
                {g.data.animatedMediaSrc ? "Motion asset" : "Motion reserved"}
              </span>
            )}
          </div>
        </li>
      ))
    }
  </ul>

  <div class="section-title">
    <h2>Popular tools</h2>
    <a href={withBase("/tools/")}>Browse tools</a>
  </div>
  <div class="card-grid">
    <a class="card" href={withBase("/tools/once-human-materials/")} style="text-decoration: none; color: inherit">
      <h3>Once Human · Material checklist</h3>
      <p>Printable / tick-friendly table for seasonal grinds — no network calls.</p>
      <span class="pill pill--accent">Low risk</span>
    </a>
    <a class="card" href={withBase("/tools/event-calendar/")} style="text-decoration: none; color: inherit">
      <h3>UTC event calendar shell</h3>
      <p>Anchor weekly resets without binding to unofficial datamines.</p>
      <span class="pill pill--accent">Low risk</span>
    </a>
    <a class="card" href={withBase("/tools/map-hub/")} style="text-decoration: none; color: inherit">
      <h3>Map hub (placeholder)</h3>
      <p>Reserved for annotated maps and route overlays when assets are cleared.</p>
      <span class="pill">Coming soon</span>
    </a>
  </div>

  <div class="section-title">
    <h2>Briefings digest</h2>
    <a href={withBase("/news/")}>View all</a>
  </div>
  <ul class="list-plain">
    {
      latestNews.map((n) => (
        <li>
          <a href={withBase(`/news/${n.slug}/`)}>{n.data.title}</a>
          <div class="muted" style="margin-top: 0.25rem">
            {n.data.published.toLocaleDateString("en-US")} · {n.data.kind} · {n.data.freshness}
          </div>
        </li>
      ))
    }
  </ul>
</PageLayout>
