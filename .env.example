# Optional: Cloudflare Web Analytics token (injected in BaseLayout when set)
PUBLIC_CF_ANALYTICS_TOKEN=

# Do NOT set these on your own PC for day-to-day work. GitHub Actions sets them during deploy.
# If BASE_PATH is set while you run `npm run build` locally, then `npm run preview` at http://127.0.0.1:4321/
# will look broken (no dark theme) because CSS URLs will not match.
# PUBLIC_SITE_URL=
# BASE_PATH=
